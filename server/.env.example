NODE_ENV=development
PORT=3011

# Local dev only (docker compose.yml). Production uses POSTGRES_PASSWORD / REDIS_PASSWORD; do not set DATABASE_URL or REDIS_URL on VPS.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mirafood
# REDIS_URL=redis://localhost:6380

# Production VPS (required; use hex passwords: openssl rand -hex 24)
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081,https://mirafood.vitaway.org,https://vitaway.nsengi.space

# Optional: Expo push access token (https://expo.dev/accounts/[account]/settings/access-tokens)
EXPO_ACCESS_TOKEN=

# Sign in with Apple — comma-separated audiences (iOS bundle id and/or Services ID)
APPLE_CLIENT_IDS=com.vitaway.foodai
# Optional: only needed for Apple server APIs (token revoke). Mobile auth verifies JWTs via Apple JWKS.
# APPLE_SIGN_IN_KEY_ID=6297PZKVH2
# APPLE_TEAM_ID=ZGZ2JG728D
# APPLE_SIGN_IN_KEY_PATH=/secure/path/AuthKey_6297PZKVH2.p8

# Google Sign-In — comma-separated OAuth client IDs (iOS + Android + Web)
# GOOGLE_CLIENT_IDS=123.apps.googleusercontent.com,456.apps.googleusercontent.com

# Anthropic Claude (plate detection + meal analysis)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_TEMPERATURE=0.05
PLATE_GEOMETRY_DISTANCE_WEIGHT=0.72

AUTO_RUN_MIGRATIONS=true
SEED_COACH_EMAIL=coach@vitaway.org
SEED_COACH_PASSWORD=Test@123
SEED_ADMIN_EMAIL=admin@vitaway.org
SEED_ADMIN_PASSWORD=Test@123
SEED_CONSUMER_EMAIL=patient@vitaway.org
SEED_CONSUMER_PASSWORD=Test@123
SEED_NUTRITION_COACH_EMAIL=nutrition@vitaway.org
SEED_NUTRITION_COACH_PASSWORD=Test@123
SEED_ORG_ADMIN_EMAIL=orgadmin@vitaway.org
SEED_ORG_ADMIN_PASSWORD=Test@123
SEED_DATA_ENTRY_EMAIL=dataentry@vitaway.org
SEED_DATA_ENTRY_PASSWORD=Test@123

# MiraFood web app (coach/admin dashboard + email links). Production: https://mirafood.vitaway.org
APP_URL=http://localhost:5173

# Mobile app scheme (deep links / general app URL scheme)
MOBILE_APP_SCHEME=mirafood

# Transactional email (Gmail SMTP; same setup as piko/inzu)
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MiraFood <noreply@vitaway.org>

# Public URL for uploaded avatars (production: https://vitaway.nsengi.space)
# PUBLIC_API_URL=https://vitaway.nsengi.space

# IremboPay (production keys live only in VPS .env; never commit secrets)
# Docs: https://irembopay.gitbook.io/irembopay-api-docs
# Callback: https://vitaway.nsengi.space/api/v1/payments/irembo/webhook
# IREMBO_PAY_BASE_URL=https://api.irembopay.com/payments
# IREMBO_PAY_PUBLIC_KEY=
# IREMBO_PAY_SECRET_KEY=
# IREMBO_PAYOUT_ACCOUNT=VITAWAY_HEALTH_RWF
# IREMBO_PAY_WIDGET=https://dashboard.irembopay.com/assets/payment/inline.js
# IREMBO_SERVICE_FEE_CODE=PC-8ccbd6ab27
# IREMBO_SHIPPING_PRODUCT_CODE=3f5490a204

# Subscription / security gates (ENFORCE_SUBSCRIPTIONS defaults true in production)
# ENFORCE_SUBSCRIPTIONS=true
ENFORCE_ORG_MODULES=false
# MFA for coach/admin (defaults on in production)
# MFA_REQUIRED_FOR_STAFF=true
ENABLE_LEGACY_PLATES_DETECT=false

# Open Food Facts (barcode lookup — server-side only)
OFF_CONTACT_EMAIL=iamnsengi@gmail.com
# OFF_ORIGIN=https://world.openfoodfacts.org
# OFF_FETCH_TIMEOUT_MS=7000
# OFF_FETCH_RETRIES=1
# OFF_CACHE_TTL_SECONDS=604800
# OFF_MISS_CACHE_TTL_SECONDS=300
# OFF_SEARCH_CACHE_TTL_SECONDS=3600
# OFF_LOCK_TTL_SECONDS=30
# OFF_LOCK_WAIT_MS=15000
