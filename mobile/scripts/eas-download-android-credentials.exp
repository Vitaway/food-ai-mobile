#!/usr/bin/expect -f
set timeout 180
cd [file dirname [file normalize [info script]]]/..
spawn eas credentials -p android
expect {
  "Which build profile do you want to configure?" {
    send "\r"
    exp_continue
  }
  "What do you want to do?" {
    exp_continue
  }
  -re "credentials.json.*Upload/Download" {
    send "\033[B\r"
    exp_continue
  }
  -re "Download credentials from EAS to credentials.json" {
    send "\r"
    exp_continue
  }
  "Press any key to continue" {
    send "\r"
    exp_continue
  }
  eof
  timeout {
    puts "TIMEOUT waiting for eas credentials"
    exit 1
  }
}
wait
exit 0
