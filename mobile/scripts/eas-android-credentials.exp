#!/usr/bin/expect -f
set timeout 180
set action [lindex $argv 0]
if {$action ne "download" && $action ne "upload"} {
  puts "Usage: eas-android-credentials.exp download|upload"
  exit 1
}
cd [file dirname [file normalize [info script]]]/..
spawn eas credentials -p android
expect "Which build profile do you want to configure?"
# development -> preview -> apk -> production (3 downs)
send "\033\[B"
send "\033\[B"
send "\033\[B"
send "\r"
expect "What do you want to do?"
# Keystore -> Google SA -> FCM Legacy -> credentials.json (3 downs)
send "\033\[B"
send "\033\[B"
send "\033\[B"
send "\r"
if {$action eq "download"} {
  expect {
    -re "Download credentials from EAS to credentials.json" {
      send "\r"
    }
    -re "Upload credentials from credentials.json to EAS" {
      puts "ERROR: expected download menu"
      exit 1
    }
  }
} else {
  expect -re "Download credentials from EAS to credentials.json"
  send "\033\[B"
  send "\r"
  expect -re "Select build credentials"
  send "\r"
  expect {
    -re "Overwrite" { send "y\r" }
    -re "Are you sure" { send "y\r" }
    timeout {}
  }
}
expect {
  -re "Press any key to continue" { send "\r" }
  -re "synced with values stored on EAS" {}
  timeout {}
}
expect eof
wait
exit 0
